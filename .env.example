# AeroCompliance AI Environment Variables

# Supabase (PostgreSQL + Auth + Storage + pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (Embeddings & Compliance Reasoning)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Application Mode
# Set to 'live' when Supabase & OpenAI credentials are configured,
# or 'demo' to run the comprehensive pre-seeded aviation engine locally.
NEXT_PUBLIC_APP_MODE=demo
